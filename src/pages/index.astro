    <footer>
        © <span id="year"></span> Erik Role
    </footer>

    <script>
        // Set current year
        document.getElementById('year').textContent = new Date().getFullYear();

        // Listen for system theme changes
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
            if (!localStorage.getItem('theme')) {
                document.documentElement.classList.toggle('dark', e.matches);
            }
        });

        // Layered scroll fade effect
        const bioLayer = document.querySelector('.bio-layer');
        const resumeLayer = document.querySelector('.resume-layer');

        function updateLayers() {
            const scrollY = window.scrollY;
            const windowHeight = window.innerHeight;

            // Start fading at 20vh scroll, complete by 60vh
            const fadeStart = windowHeight * 0.2;
            const fadeEnd = windowHeight * 0.6;

            let progress = (scrollY - fadeStart) / (fadeEnd - fadeStart);
            progress = Math.max(0, Math.min(1, progress));

            // Fade bio out, resume in
            bioLayer.style.opacity = 1 - progress;
            resumeLayer.style.opacity = progress;
        }

        window.addEventListener('scroll', updateLayers);
        updateLayers(); // Initial call
    </script>
</body>
</html>
