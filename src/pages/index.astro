---
import '@/styles/globals.css';
import { Site } from '@/components/Site';

const siteUrl = "https://erikrole.com";
const pageTitle = "Erik Role — Assistant Director of Creative Video";
const pageDescription =
    "Creative video producer leading visual storytelling for Wisconsin Men's Basketball.";
const socialImage = "/img/20240731-240731MBB-3329-Role-Edit.webp";
const canonicalUrl = `${siteUrl}/`;
const socialImageUrl = `${siteUrl}${socialImage}`;

const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Erik Role",
    url: canonicalUrl,
    image: socialImageUrl,
    jobTitle: "Assistant Director of Creative Video",
    worksFor: {
        "@type": "SportsOrganization",
        name: "Wisconsin Badgers",
        url: "https://uwbadgers.com",
    },
    alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "University of Wisconsin-Madison",
    },
    knowsAbout: [
        "Video Production",
        "Creative Direction",
        "Social Media Content",
        "In-Venue Production",
        "Brand Strategy",
    ],
    sameAs: [
        "https://www.linkedin.com/in/erikrole/",
        "https://www.instagram.com/erikrole/",
        "https://x.com/ErikRole",
    ],
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f5efe2" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#221f1c" media="(prefers-color-scheme: dark)">
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription}>
    <meta name="author" content="Erik Role">
    <link rel="canonical" href={canonicalUrl}>

    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={pageDescription}>
    <meta property="og:image" content={socialImageUrl}>
    <meta property="og:site_name" content="Erik Role">
    <meta property="og:locale" content="en_US">

    <meta name="robots" content="index,follow,max-image-preview:large">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={pageTitle}>
    <meta name="twitter:description" content={pageDescription}>
    <meta name="twitter:image" content={socialImageUrl}>
    <meta name="twitter:site" content="@ErikRole">
    <meta name="twitter:creator" content="@ErikRole">

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/favicon.svg">

    <link rel="preload" as="font" href="/fonts/abril-fatface-400.woff2" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="/fonts/darker-grotesque.woff2" type="font/woff2" crossorigin>

    <script is:inline>
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
        }
    </script>
</head>
<body>
    <Site client:load />

    <script>
        const darkModeQuery = window.matchMedia('(prefers-color-scheme: dark)');
        darkModeQuery.addEventListener('change', (e) => {
            document.documentElement.classList.toggle('dark', e.matches);
            document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
        });
    </script>
</body>
</html>
