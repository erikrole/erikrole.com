    <footer>
        © <span id="year"></span> Erik Role
    </footer>

    <script>
        // Set current year
        document.getElementById('year').textContent = new Date().getFullYear();

        // Listen for system theme changes
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
            if (!localStorage.getItem('theme')) {
                document.documentElement.classList.toggle('dark', e.matches);
            }
        });

        // Mobile scroll behavior
        let isMobile = window.innerWidth <= 768;

        if (isMobile) {
            const profile = document.querySelector('.profile');
            const initialContent = document.querySelector('.initial-content');
            const resumeSection = document.querySelector('.resume-section');
            const scrollIndicator = document.querySelector('.scroll-indicator');

            const SCROLL_START = 50;
            const SCROLL_COMPLETE = 200;

            let scrollTimeout;
            function handleScroll() {
                if (!isMobile) return;

                const scrollY = window.scrollY;

                if (scrollY > SCROLL_START) {
                    profile.classList.add('scrolled');
                    initialContent.classList.add('hidden');
                    resumeSection.classList.add('visible');
                    scrollIndicator.classList.add('hidden');
                } else {
                    profile.classList.remove('scrolled');
                    initialContent.classList.remove('hidden');
                    resumeSection.classList.remove('visible');
                    scrollIndicator.classList.remove('hidden');
                }
            }

            function throttledScroll() {
                if (scrollTimeout) return;
                scrollTimeout = setTimeout(() => {
                    handleScroll();
                    scrollTimeout = null;
                }, 16);
            }

            window.addEventListener('scroll', throttledScroll, { passive: true });

            // Handle resize
            window.addEventListener('resize', () => {
                const wasMobile = isMobile;
                isMobile = window.innerWidth <= 768;

                if (!isMobile && wasMobile) {
                    // Switched to desktop - reset
                    profile.classList.remove('scrolled');
                    initialContent.classList.remove('hidden');
                    resumeSection.classList.remove('visible');
                    scrollIndicator.classList.remove('hidden');
                } else if (isMobile && !wasMobile) {
                    // Switched to mobile - evaluate
                    handleScroll();
                }
            });

            // Handle page cache restore
            window.addEventListener('pageshow', (event) => {
                if (event.persisted) {
                    handleScroll();
                }
            });

            // Initial call
            handleScroll();
        }
    </script>
</body>
</html>
