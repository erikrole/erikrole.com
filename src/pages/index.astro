---
import Layout from '@/layouts/Layout.astro';
import TopBar from '@/components/TopBar.astro';
import Hero from '@/components/Hero.astro';
import SelectedWork from '@/components/SelectedWork.astro';
import About from '@/components/About.astro';
import Experience from '@/components/Experience.astro';
import Footer from '@/components/Footer.astro';
import { PROFILE } from '@/data/site';
import portrait from '@/assets/erik-role-portrait.webp';
import { getImage } from 'astro:assets';

const siteUrl = "https://erikrole.com";
const pageTitle = `${PROFILE.name} — ${PROFILE.title}`;
const pageDescription =
    "Creative video producer leading visual storytelling for Wisconsin Men's Basketball.";
const socialImage = await getImage({
    src: portrait,
    width: 1200,
    height: 630,
    fit: 'cover',
    position: 'center',
    format: 'webp',
});
const canonicalUrl = `${siteUrl}/`;
const socialImageUrl = `${siteUrl}${socialImage.src}`;

const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: PROFILE.name,
    url: canonicalUrl,
    image: socialImageUrl,
    jobTitle: PROFILE.title,
    worksFor: {
        "@type": "SportsOrganization",
        name: "Wisconsin Badgers",
        url: "https://uwbadgers.com",
    },
    alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "University of Wisconsin-Madison",
    },
    knowsAbout: [
        "Video Production",
        "Creative Direction",
        "Social Media Content",
        "In-Venue Production",
        "Brand Strategy",
    ],
    sameAs: [
        "https://www.linkedin.com/in/erikrole/",
        "https://www.instagram.com/erikrole/",
        "https://x.com/ErikRole",
    ],
};
---

<Layout
    title={pageTitle}
    description={pageDescription}
    canonicalUrl={canonicalUrl}
    socialImageUrl={socialImageUrl}
>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>

    <TopBar />
    <main>
        <Hero />
        <SelectedWork />
        <About />
        <Experience />
    </main>
    <Footer />
</Layout>
