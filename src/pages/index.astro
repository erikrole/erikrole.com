---
// Minimal personal site for Erik Role
---

<!DOCTYPE html>
<html lang="en" style="color-scheme: light dark;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>Erik Role</title>
    <meta name="description" content="Assistant Director of Creative Video at Wisconsin Badgers">
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Abril+Fatface&display=swap" rel="stylesheet">

    <script is:inline>
        // Run BEFORE page renders to prevent flash
        const theme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

        if (theme === 'dark' || (!theme && prefersDark)) {
            document.documentElement.classList.add('dark');
        }
    </script>

    <style>
        :root {
            --transition-duration: 0.4s;
            --transition-easing: cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            color-scheme: light dark;
            --bg: #f5f4f0;
            --text: #1a1a1a;
            --text-secondary: #666;
            --border: #e0e0e0;
        }

        html.dark {
            color-scheme: dark;
            --bg: #2a2a2a;
            --text: #f5f5f5;
            --text-secondary: #b0b0b0;
            --border: #444;
        }

        html.dark .logo-light {
            display: none;
        }

        html.dark .logo-dark {
            display: block;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.5;
            transition: background-color 0.3s ease, color 0.3s ease;
            overflow-x: hidden;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 40px 24px 80px;
        }

        /* Profile Section */
        .profile {
            text-align: center;
            margin-bottom: 32px;
        }

        .profile-photo {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            margin: 0 auto 20px;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .profile-photo:hover {
            transform: translateY(-4px);
        }

        .profile-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        h1 {
            font-family: 'Abril Fatface', serif;
            font-size: 56px;
            font-weight: 400;
            margin-bottom: 8px;
            letter-spacing: -0.02em;
            line-height: 1;
        }

        .title {
            font-size: 15px;
            color: var(--text-secondary);
            font-weight: 400;
        }

        /* Initial Content (Bio & Social) */
        .initial-content {
            text-align: center;
            margin-bottom: 32px;
        }

        .bio {
            font-size: 15px;
            line-height: 1.6;
            color: var(--text);
            margin-bottom: 24px;
            max-width: 520px;
            margin-left: auto;
            margin-right: auto;
        }

        .social-links {
            display: flex;
            gap: 20px;
            justify-content: center;
        }

        .social-link {
            color: var(--text);
            opacity: 0.6;
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        .social-link:hover {
            opacity: 1;
            transform: translateY(-2px);
        }

        .social-icon {
            width: 20px;
            height: 20px;
            display: block;
        }

        /* Resume Section */
        .resume-section {
            margin-top: 40px;
        }

        .resume {
            width: 100%;
        }

        .resume-divider {
            height: 1px;
            background: var(--border);
            margin: 20px 0;
        }

        .experience-item {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border);
        }

        .experience-item:last-child {
            border-bottom: none;
        }

        .company-logo {
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .company-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .logo-light {
            display: block;
        }

        .logo-dark {
            display: none;
        }

        .experience-details {
            flex: 1;
        }

        .job-title {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .duration {
            font-size: 12px;
            color: var(--text-secondary);
        }

        /* Scroll Indicator */
        .scroll-indicator {
            position: fixed;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            color: var(--text-secondary);
            opacity: 1;
            transition: opacity 0.3s ease;
            cursor: pointer;
        }

        .scroll-indicator.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .arrow-icon {
            width: 24px;
            height: 24px;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% {
                transform: translateY(0);
            }
            40% {
                transform: translateY(-10px);
            }
            60% {
                transform: translateY(-5px);
            }
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 40px 24px;
            font-size: 13px;
            color: var(--text-secondary);
        }

        /* Mobile: Scroll Behavior */
        @media (max-width: 768px) {
            body {
                min-height: 200vh; /* Allow scrolling */
            }

            .container {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 60px 20px 60px;
            }

            .profile {
                position: sticky;
                top: 0;
                z-index: 10;
                background: var(--bg);
                padding: 20px 0;
                margin-bottom: 32px;
                transition: padding var(--transition-duration) var(--transition-easing),
                            box-shadow var(--transition-duration) var(--transition-easing);
            }

            .profile.scrolled {
                padding: 12px 0;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            }

            .profile-photo {
                transition: all var(--transition-duration) var(--transition-easing);
                will-change: transform, width, height;
            }

            .profile.scrolled .profile-photo {
                width: 50px;
                height: 50px;
                margin-bottom: 12px;
            }

            .profile.scrolled .profile-photo:hover {
                transform: none;
            }

            h1 {
                font-size: 48px;
                transition: font-size var(--transition-duration) var(--transition-easing);
                will-change: font-size;
            }

            .profile.scrolled h1 {
                font-size: 28px;
            }

            .title {
                font-size: 13px;
                transition: font-size var(--transition-duration) var(--transition-easing);
                will-change: font-size;
            }

            .profile.scrolled .title {
                font-size: 11px;
            }

            /* Initial content fades out */
            .initial-content {
                transition: opacity var(--transition-duration) var(--transition-easing),
                            transform var(--transition-duration) var(--transition-easing);
                will-change: opacity, transform;
            }

            .initial-content.hidden {
                opacity: 0;
                transform: translateY(-20px);
                pointer-events: none;
            }

            /* Resume appears */
            .resume-section {
                opacity: 0;
                transform: translateY(20px);
                transition: opacity var(--transition-duration) var(--transition-easing),
                            transform var(--transition-duration) var(--transition-easing);
                will-change: opacity, transform;
            }

            .resume-section.visible {
                opacity: 1;
                transform: translateY(0);
            }

            .bio {
                font-size: 14px;
            }
        }

        /* Desktop: Static Layout */
        @media (min-width: 769px) {
            body {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .container {
                flex: 1;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .profile {
                position: static;
            }

            .initial-content,
            .resume-section {
                opacity: 1 !important;
                transform: none !important;
                transition: none !important;
            }

            .scroll-indicator {
                display: none;
            }
        }

        /* Reduced Motion */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>
