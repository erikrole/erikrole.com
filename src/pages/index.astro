                Instagram
            </a>
            <a href="https://x.com/ErikRole" target="_blank" rel="noopener" class="social-link">
                <svg class="social-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                X
            </a>
            <a href="https://www.linkedin.com/in/erikrole/" target="_blank" rel="noopener" class="social-link">
                <svg class="social-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                LinkedIn
            </a>
        </div>

        <!-- Resume -->
        <div class="resume">
            <div class="section-label">/experience</div>

            <div class="experience-item">
                <div class="company">Wisconsin Athletics</div>
                <div class="role">Assistant Director of Creative Video</div>
                <div class="duration">Jun 2025 – Present · Madison, WI</div>
            </div>

            <div class="experience-item">
                <div class="company">Wisconsin Athletics</div>
                <div class="role">Digital Producer</div>
                <div class="duration">Jun 2019 – Jun 2025 · 6 yrs · Madison, WI</div>
                <p class="description">
                    Lead creative direction and strategy for Wisconsin Men's Basketball.
                    Produce compelling in-venue content for football and men's basketball.
                </p>
            </div>

            <div class="experience-item">
                <div class="company">Milwaukee Bucks</div>
                <div class="role">Videoboard Content Creator</div>
                <div class="duration">Oct 2022 – Present · Part-time · Remote</div>
            </div>

            <div class="experience-item">
                <div class="company">Milwaukee Brewers</div>
                <div class="role">Videoboard Content Creator</div>
                <div class="duration">Mar 2018 – Dec 2023 · 5 yrs 10 mos · Freelance</div>
            </div>

            <div class="experience-item">
                <div class="company">Big Ten Network</div>
                <div class="role">Multi-Platform Video Editor</div>
                <div class="duration">Aug 2018 – May 2019 · 10 mos · Madison, WI</div>
                <p class="description">
                    Shot and edited content for @WisconsinOnBTN social media channels.
                    Led creative production for Big Ten Network digital platforms.
                </p>
            </div>
        </div>
    </div>

    <footer>
        © 2026 Erik Role
    </footer>

    <script>
        // Theme toggle functionality
        const themeToggle = document.getElementById('themeToggle');
        const html = document.documentElement;
        const sun = document.querySelector('.sun');
        const moon = document.querySelector('.moon');

        // Check for saved theme preference or default to light mode
        const currentTheme = localStorage.getItem('theme') || 'light';
        html.setAttribute('data-theme', currentTheme);
        updateToggleIcon(currentTheme);

        themeToggle.addEventListener('click', () => {
            const currentTheme = html.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

            html.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            updateToggleIcon(newTheme);
        });

        function updateToggleIcon(theme) {
            if (theme === 'dark') {
                sun.style.display = 'none';
                moon.style.display = 'inline';
            } else {
                sun.style.display = 'inline';
                moon.style.display = 'none';
            }
        }
    </script>
</body>
</html>
