---
// Minimal personal site for Erik Role
const siteUrl = "https://erikrole.com";
const pageTitle = "Erik Role";
const pageDescription =
    "Assistant Director of Creative Video at Wisconsin Badgers";
const socialImage = "/img/20240731-240731MBB-3329-Role-Edit.jpeg";
const canonicalUrl = `${siteUrl}/`;
const socialImageUrl = `${siteUrl}${socialImage}`;

const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Erik Role",
    url: canonicalUrl,
    image: socialImageUrl,
    jobTitle: "Assistant Director of Creative Video",
    worksFor: {
        "@type": "SportsOrganization",
        name: "Wisconsin Badgers",
    },
    sameAs: [
        "https://www.linkedin.com/in/erikrole/",
        "https://instagram.com/erik_role",
    ],
};
---

<!DOCTYPE html>
<html lang="en" style="color-scheme: light dark;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription}>
    <link rel="canonical" href={canonicalUrl}>

    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={pageDescription}>
    <meta property="og:image" content={socialImageUrl}>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={pageTitle}>
    <meta name="twitter:description" content={pageDescription}>
    <meta name="twitter:image" content={socialImageUrl}>

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/img/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Abril+Fatface&display=swap" rel="stylesheet">

    <script is:inline>
        // Run BEFORE page renders to prevent flash
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
        }
    </script>

    <style>
        :root {
            --transition-duration: 0.3s;
            --transition-easing: cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            color-scheme: light dark;
            --bg: #f5f4f0;
            --text: #1a1a1a;
            --text-secondary: #666;
            --border: #e0e0e0;
        }

        html.dark {
            color-scheme: dark;
            --bg: #2a2a2a;
            --text: #f5f5f5;
            --text-secondary: #b0b0b0;
            --border: #444;
        }

        html.dark .logo-light {
            display: none;
        }

        html.dark .logo-dark {
            display: block;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.5;
            transition: background-color 0.2s ease, color 0.2s ease;
            overflow-x: hidden;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 40px 24px 80px;
        }

        /* Profile Section */
        .profile {
            text-align: center;
            margin-bottom: 32px;
        }

        .profile-photo {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            margin: 0 auto 20px;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .profile-photo:hover {
            transform: translateY(-4px);
        }

        .profile-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        h1 {
            font-family: Georgia, 'Times New Roman', Times, serif;
            font-size: 56px;
            font-weight: 400;
            margin-bottom: 8px;
            letter-spacing: -0.02em;
            line-height: 1;
        }

        .title {
            font-size: 15px;
            color: var(--text-secondary);
            font-weight: 400;
        }

        /* Initial Content (Bio & Social) */
        .initial-content {
            text-align: center;
            margin-bottom: 32px;
        }

        .bio {
            font-size: 15px;
            line-height: 1.6;
            color: var(--text);
            margin-bottom: 24px;
            max-width: 520px;
            margin-left: auto;
            margin-right: auto;
        }

        .social-links {
            display: flex;
            gap: 20px;
            justify-content: center;
        }

        .social-link {
            color: var(--text);
            opacity: 0.6;
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        .social-link:hover {
            opacity: 1;
            transform: translateY(-2px);
        }

        .social-icon {
            width: 20px;
            height: 20px;
            display: block;
        }

        /* Resume Section */
        .resume-section {
            margin-top: 40px;
        }

        .resume {
            width: 100%;
        }

        .resume-divider {
            height: 1px;
            background: var(--border);
            margin: 16px 0;
        }

        .experience-item {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border);
        }

        .experience-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        /* Remove extra spacing before divider */
        .experience-item:has(+ .resume-divider) {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .company-logo {
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .company-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .logo-light {
            display: block;
        }

        .logo-dark {
            display: none;
        }

        .experience-details {
            flex: 1;
        }

        .job-title {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .duration {
            font-size: 12px;
            color: var(--text-secondary);
        }

        /* Scroll Indicator */
        .scroll-indicator {
            position: fixed;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            color: var(--text-secondary);
            opacity: 1;
            transition: opacity 0.3s ease;
            cursor: pointer;
        }

        .scroll-indicator.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .arrow-icon {
            width: 24px;
            height: 24px;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 100% {
                transform: translateY(0);
                animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
            }
            50% {
                transform: translateY(-8px);
                animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
            }
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 24px 24px 40px;
            font-size: 13px;
            color: var(--text-secondary);
            position: sticky;
            bottom: 0;
            background: var(--bg);
        }

        /* Mobile: Scroll Behavior */
        @media (max-width: 768px) {
            body {
                min-height: 100vh;
            }

            .container {
                min-height: calc(100vh - 88px); /* Account for footer height */
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 60px 20px 20px;
            }

            .profile {
                position: sticky;
                top: 0;
                z-index: 10;
                background: var(--bg);
                padding: 20px 0;
                margin-bottom: 32px;
                transition: padding var(--transition-duration) var(--transition-easing),
                            backdrop-filter var(--transition-duration) var(--transition-easing);
            }

            .profile.scrolled {
                padding: 12px 0;
                backdrop-filter: blur(10px);
                background: color-mix(in srgb, var(--bg) 80%, transparent);
            }

            .profile-photo {
                transition: width var(--transition-duration) var(--transition-easing),
                            height var(--transition-duration) var(--transition-easing),
                            margin-bottom var(--transition-duration) var(--transition-easing);
            }

            .profile.scrolled .profile-photo {
                width: 50px;
                height: 50px;
                margin-bottom: 12px;
            }

            .profile.scrolled .profile-photo:hover {
                transform: none;
            }

            h1 {
                font-size: 48px;
                transform-origin: center;
                transition: transform var(--transition-duration) var(--transition-easing);
            }

            .profile.scrolled h1 {
                transform: scale(0.583); /* 28px / 48px = 0.583 */
            }

            .title {
                font-size: 13px;
                transform-origin: center;
                transition: transform var(--transition-duration) var(--transition-easing);
            }

            .profile.scrolled .title {
                transform: scale(0.846); /* 11px / 13px = 0.846 */
            }

            /* Initial content fades out */
            .initial-content {
                transition: opacity var(--transition-duration) var(--transition-easing),
                            transform var(--transition-duration) var(--transition-easing);
            }

            .initial-content.hidden {
                opacity: 0;
                transform: translate3d(0, -20px, 0);
                pointer-events: none;
            }

            /* Resume appears */
            .resume-section {
                opacity: 0;
                transform: translate3d(0, 20px, 0);
                transition: opacity var(--transition-duration) var(--transition-easing),
                            transform var(--transition-duration) var(--transition-easing);
            }

            .resume-section.visible {
                opacity: 1;
                transform: translate3d(0, 0, 0);
            }

            .bio {
                font-size: 14px;
            }
        }

        /* Desktop: Static Layout */
        @media (min-width: 769px) {
            body {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .container {
                flex: 1;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .profile {
                position: static;
            }

            .initial-content,
            .resume-section {
                opacity: 1 !important;
                transform: none !important;
                transition: none !important;
            }

            .scroll-indicator {
                display: none;
            }
        }

        /* Reduced Motion */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Profile -->
        <div id="about" class="profile">
            <div class="profile-photo">
                <img src="/img/20240731-240731MBB-3329-Role-Edit.jpeg" alt="Erik Role" />
            </div>
            <h1>ERIK ROLE</h1>
            <p class="title">Assistant Director of Creative Video / Wisconsin Badgers</p>
        </div>

        <!-- Initial Content (Bio & Social) -->
        <div class="initial-content">
            <p class="bio">
                Creative video producer leading visual storytelling for Wisconsin Men's Basketball.
                Specializing in social-first content, in-venue production, and brand strategy.
            </p>

            <div id="contact" class="social-links">
                <a id="email-link" href="#contact" class="social-link" aria-label="Email">
                    <svg class="social-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                </a>
                <a href="https://www.instagram.com/erikrole/" target="_blank" rel="noopener me" class="social-link" aria-label="Instagram">
                    <svg class="social-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>
                <a href="https://x.com/ErikRole" target="_blank" rel="noopener me" class="social-link" aria-label="X (Twitter)">
                    <svg class="social-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
                <a href="https://www.linkedin.com/in/erikrole/" target="_blank" rel="noopener me" class="social-link" aria-label="LinkedIn">
                    <svg class="social-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
            </div>
        </div>

        <!-- Resume Section -->
        <div id="resume" class="resume-section">
            <div class="resume">
                <!-- PRESENT ROLES -->
                <div class="experience-item">
                    <div class="company-logo">
                        <img src="/img/Badgers.png" alt="Wisconsin Badgers" />
                    </div>
                    <div class="experience-details">
                        <div class="job-title">Assistant Director of Creative Video / Wisconsin Badgers</div>
                        <div class="duration">Jun 2025 – Present</div>
                    </div>
                </div>

                <div class="experience-item">
                    <div class="company-logo">
                        <img src="/img/Bucks.png" alt="Milwaukee Bucks" />
                    </div>
                    <div class="experience-details">
                        <div class="job-title">Videoboard Content Creator / Milwaukee Bucks</div>
                        <div class="duration">Oct 2022 – Present · Part-time</div>
                    </div>
                </div>

                <!-- DIVIDER -->
                <div class="resume-divider"></div>

                <!-- PREVIOUS ROLES -->
                <div class="experience-item">
                    <div class="company-logo">
                        <img src="/img/Badgers.png" alt="Wisconsin Badgers" />
                    </div>
                    <div class="experience-details">
                        <div class="job-title">Digital Producer / Wisconsin Badgers</div>
                        <div class="duration">Jun 2019 – Jun 2025</div>
                    </div>
                </div>

                <div class="experience-item">
                    <div class="company-logo">
                        <img src="/img/Brewers.png" alt="Milwaukee Brewers" />
                    </div>
                    <div class="experience-details">
                        <div class="job-title">Videoboard Content Creator / Milwaukee Brewers</div>
                        <div class="duration">Mar 2018 – Dec 2023</div>
                    </div>
                </div>

                <div class="experience-item">
                    <div class="company-logo">
                        <img class="logo-light" src="/img/B1G Network-Black.png" alt="Big Ten Network" />
                        <img class="logo-dark" src="/img/B1G Network-White.png" alt="Big Ten Network" />
                    </div>
                    <div class="experience-details">
                        <div class="job-title">Multi-Platform Video Editor / Big Ten Network</div>
                        <div class="duration">Aug 2018 – May 2019</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Scroll Indicator (mobile only) -->
        <div class="scroll-indicator" aria-label="Scroll to see resume">
            <svg class="arrow-icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
            </svg>
        </div>
    </div>

    <footer>
        © <span id="year"></span> Erik Role
    </footer>

    <script>
        // Set current year
        document.getElementById('year').textContent = new Date().getFullYear();

        // Basic email obfuscation to reduce static scraping
        const emailLink = document.getElementById('email-link');
        if (emailLink) {
            const localPart = ['erik', 'role'].join('');
            const domain = ['gmail', 'com'].join('.');
            const address = `${localPart}@${domain}`;

            emailLink.setAttribute('href', `mailto:${address}`);
            emailLink.setAttribute('title', address);
        }

        // Listen for system theme changes
        const darkModeQuery = window.matchMedia('(prefers-color-scheme: dark)');
        const syncDarkClass = (eventOrQuery) => {
            const isDark = 'matches' in eventOrQuery ? eventOrQuery.matches : darkModeQuery.matches;
            document.documentElement.classList.toggle('dark', isDark);
        };

        if (typeof darkModeQuery.addEventListener === 'function') {
            darkModeQuery.addEventListener('change', syncDarkClass);
        } else if (typeof darkModeQuery.addListener === 'function') {
            darkModeQuery.addListener(syncDarkClass);
        }

        syncDarkClass(darkModeQuery);

        const profile = document.querySelector('.profile');
        const initialContent = document.querySelector('.initial-content');
        const resumeSection = document.querySelector('.resume-section');
        const scrollIndicator = document.querySelector('.scroll-indicator');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        let isMobile = window.matchMedia('(max-width: 768px)').matches;
        let revealObserver;

        function setResumeVisible(isVisible) {
            profile.classList.toggle('scrolled', isVisible);
            initialContent.classList.toggle('hidden', isVisible);
            resumeSection.classList.toggle('visible', isVisible);
            scrollIndicator.classList.toggle('hidden', isVisible || !isMobile);
        }

        function setupMobileReveal() {
            if (revealObserver) {
                revealObserver.disconnect();
            }

            if (!isMobile) {
                setResumeVisible(true);
                return;
            }

            setResumeVisible(false);

            const rootMargin = reducedMotion ? '-6% 0px -70% 0px' : '-10% 0px -65% 0px';
            revealObserver = new IntersectionObserver(
                ([entry]) => {
                    setResumeVisible(!entry.isIntersecting);
                },
                {
                    threshold: 0,
                    rootMargin,
                },
            );

            revealObserver.observe(initialContent);
        }

        function handleViewportChange() {
            const wasMobile = isMobile;
            isMobile = window.matchMedia('(max-width: 768px)').matches;

            if (wasMobile !== isMobile) {
                setupMobileReveal();
            }
        }

        window.addEventListener('resize', handleViewportChange, { passive: true });
        window.addEventListener('orientationchange', handleViewportChange, { passive: true });
        window.addEventListener('pageshow', () => {
            setupMobileReveal();
        });

        setupMobileReveal();
    </script>
</body>
</html>
