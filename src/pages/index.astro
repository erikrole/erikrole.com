---
// Single-page personal site for Erik Role
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Erik Role</title>
    <meta name="description" content="Video producer and storyteller for Wisconsin Athletics">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #fdfcf8;
            --text: #1a1a1a;
            --text-secondary: #666;
            --border: #e0e0e0;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        [data-theme='dark'] {
            --bg: #2a2a2a;
            --text: #f5f5f5;
            --text-secondary: #b0b0b0;
            --border: #444;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            transition: var(--transition);
            line-height: 1.6;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .container {
            max-width: 700px;
            margin: 0 auto;
            padding: 80px 24px 40px;
            flex: 1;
        }

        /* Theme Toggle */
        .theme-toggle {
            position: fixed;
            top: 24px;
            right: 24px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 8px;
            color: var(--text);
            font-size: 24px;
            z-index: 100;
            transition: var(--transition);
        }

        .theme-toggle:hover {
            opacity: 0.7;
        }

        /* Profile Section */
        .profile {
            text-align: center;
            margin-bottom: 60px;
        }

        .profile-photo {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            margin: 0 auto 24px;
            background: var(--border);
            overflow: hidden;
        }

        .profile-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        h1 {
            font-size: 48px;
            font-weight: 700;
            margin-bottom: 8px;
            letter-spacing: -0.02em;
        }

        .title {
            font-size: 18px;
            color: var(--text-secondary);
            margin-bottom: 40px;
        }

        /* Bio Section */
        .section {
            margin-bottom: 48px;
        }

        .section-label {
            font-size: 13px;
            color: var(--text-secondary);
            margin-bottom: 16px;
            font-weight: 500;
        }

        .bio {
            font-size: 16px;
            line-height: 1.7;
            color: var(--text);
        }

        /* Social Links */
        .social-links {
            display: flex;
            gap: 16px;
            justify-content: center;
            margin-bottom: 48px;
        }

        .social-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text);
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            transition: var(--transition);
        }

        .social-link:hover {
            border-color: var(--text);
            transform: translateY(-2px);
        }

        .social-icon {
            width: 20px;
            height: 20px;
        }

        /* Resume Section */
        .resume {
            margin-top: 64px;
        }

        .experience-item {
            margin-bottom: 40px;
            padding-bottom: 40px;
            border-bottom: 1px solid var(--border);
        }

        .experience-item:last-child {
            border-bottom: none;
        }

        .company {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .role {
            font-size: 16px;
            font-weight: 500;
            margin-bottom: 4px;
        }

        .duration {
            font-size: 14px;
            color: var(--text-secondary);
            margin-bottom: 12px;
        }

        .description {
            font-size: 15px;
            color: var(--text-secondary);
            line-height: 1.6;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 40px 24px;
            font-size: 14px;
            color: var(--text-secondary);
            border-top: 1px solid var(--border);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .container {
                padding: 60px 20px 40px;
            }

            h1 {
                font-size: 36px;
            }

            .title {
                font-size: 16px;
            }

            .social-links {
                flex-direction: column;
                align-items: stretch;
            }

            .social-link {
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
        <span class="sun">☀️</span>
        <span class="moon" style="display:none;">🌙</span>
    </button>

    <div class="container">
        <!-- Profile -->
        <div class="profile">
            <div class="profile-photo">
                <!-- Placeholder - replace with your photo -->
                <img src="/img/clay-image-1.jpg" alt="Erik Role" />
            </div>
            <h1>Erik Role</h1>
            <p class="title">Assistant Director of Creative Video</p>
        </div>

        <!-- Bio -->
        <div class="section">
            <div class="section-label">/about</div>
            <p class="bio">
                Creative video producer leading visual storytelling for Wisconsin Men's Basketball.
                Specializing in social-first content, in-venue production, and brand strategy for
                high-profile college athletics programs.
            </p>
        </div>

        <!-- Social Links -->
        <div class="social-links">
            <a href="https://www.instagram.com/erikrole/" target="_blank" rel="noopener" class="social-link">
