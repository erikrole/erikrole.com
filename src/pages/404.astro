---
import '@/styles/globals.css';
import ThemeHead from '@/components/ThemeHead.astro';
import { PROFILE } from '@/data/site';

const pageTitle = "404 — Erik Role";
const pageDescription = "Page not found";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <ThemeHead />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription}>
    <meta name="robots" content="noindex">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preload" as="font" href="/fonts/anton-400.woff2" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="/fonts/archivo-var.woff2" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="/fonts/ibm-plex-mono-500.woff2" type="font/woff2" crossorigin>

    <style>
        .nf {
            min-height: 100svh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            width: min(100% - 2 * var(--gutter), var(--shell));
            margin-inline: auto;
            padding-block: 48px;
        }
        /* SMPTE colour bars — the test card a dead feed falls back to */
        .nf-bars {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            width: min(100%, 420px);
            height: 18px;
            margin-bottom: 28px;
        }
        .nf-bars span:nth-child(1) { background: var(--smpte-gray); }
        .nf-bars span:nth-child(2) { background: var(--smpte-yellow); }
        .nf-bars span:nth-child(3) { background: var(--smpte-cyan); }
        .nf-bars span:nth-child(4) { background: var(--smpte-green); }
        .nf-bars span:nth-child(5) { background: var(--smpte-magenta); }
        .nf-bars span:nth-child(6) { background: var(--smpte-red); }
        .nf-bars span:nth-child(7) { background: var(--smpte-blue); }
        .nf-eyebrow {
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: var(--font-mono);
            font-size: var(--fs-mono-m);
            font-weight: 500;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--ink-3);
            margin: 0 0 20px;
        }
        .nf-eyebrow::before {
            content: "";
            width: 8px; height: 8px;
            background: var(--accent);
        }
        .nf-code {
            font-family: var(--font-display);
            font-size: clamp(7rem, 26vw, 20rem);
            font-weight: 400;
            line-height: 0.9;
            letter-spacing: 0.01em;
            margin: 0 0 36px;
            color: var(--ink);
        }
        .nf-links {
            list-style: none;
            display: flex;
            flex-wrap: wrap;
            gap: 4px 28px;
            margin: 32px 0 0;
            padding: 0;
        }
    </style>
</head>
<body>
    <main class="nf">
        <div class="nf-bars" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <p class="nf-eyebrow">Signal lost</p>
        <h1 class="nf-code">404</h1>
        <div class="lower-third">
            <span class="lt-bar" aria-hidden="true"></span>
            <div class="lt-text">
                <span class="lt-primary">This page is off the air</span>
                <span class="lt-secondary">The link may be broken, or the page has moved</span>
            </div>
        </div>
        <nav aria-label="Back on air">
            <ul class="nf-links">
                <li><a href="/" class="text-link">← erikrole.com</a></li>
                <li><a href="/#work" class="text-link">Work</a></li>
                <li><a href="/#experience" class="text-link">Experience</a></li>
                <li><a href={`mailto:${PROFILE.email}`} class="text-link">Email</a></li>
            </ul>
        </nav>
    </main>
</body>
</html>
