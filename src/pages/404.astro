---
const pageTitle = "404 — Erik Role";
const pageDescription = "Page not found";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription}>
    <meta name="robots" content="noindex">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Inter:wght@400;600&display=swap" rel="stylesheet">

    <script is:inline>
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
        }
    </script>

    <style>
        :root {
            color-scheme: light dark;
            --bg: #f5f4f0;
            --text: #1a1a1a;
            --text-secondary: #666;
        }

        html.dark {
            color-scheme: dark;
            --bg: #2a2a2a;
            --text: #f5f5f5;
            --text-secondary: #b0b0b0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .container {
            text-align: center;
            max-width: 500px;
        }

        h1 {
            font-family: 'Abril Fatface', Georgia, serif;
            font-size: 72px;
            font-weight: 400;
            margin-bottom: 16px;
            color: var(--text);
        }

        p {
            font-size: 15px;
            color: var(--text-secondary);
            margin-bottom: 32px;
        }

        a {
            display: inline-block;
            padding: 12px 24px;
            background: var(--text);
            color: var(--bg);
            text-decoration: none;
            border-radius: 4px;
            font-weight: 600;
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        a:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

        a:focus-visible {
            outline: 2px solid var(--text);
            outline-offset: 4px;
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>404</h1>
        <p>Page not found. The page you're looking for doesn't exist or has been moved.</p>
        <a href="/">Go home</a>
    </div>
</body>
</html>
