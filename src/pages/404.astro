---
const pageTitle = "404 — Erik Role";
const pageDescription = "Page not found";
---

<!DOCTYPE html>
<html lang="en" style="color-scheme: light dark;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f5ede0" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#2d2825" media="(prefers-color-scheme: dark)">
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription}>
    <meta name="robots" content="noindex">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet"></noscript>

    <script is:inline>
        var darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
        document.documentElement.classList.toggle('dark', darkQuery.matches);
        darkQuery.addEventListener('change', function(e) {
            document.documentElement.classList.toggle('dark', e.matches);
        });
    </script>

    <style>
        :root {
            color-scheme: light dark;
            --bg: #f5ede0;
            --text: #0d0d0d;
            --text-secondary: #6b5e50;
        }

        html.dark {
            color-scheme: dark;
            --bg: #2d2825;
            --text: #f0ede8;
            --text-secondary: #a8998d;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        body {
            font-family: 'Lora', Georgia, 'Times New Roman', serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            animation: fadeIn 0.3s ease-out;
        }

        .container {
            text-align: center;
            max-width: 500px;
        }

        h1 {
            font-family: 'Abril Fatface', Georgia, serif;
            font-size: 72px;
            font-weight: 400;
            margin-bottom: 16px;
            color: var(--text);
        }

        p {
            font-size: 15px;
            color: var(--text-secondary);
            margin-bottom: 32px;
        }

        a {
            display: inline-block;
            padding: 12px 24px;
            background: var(--text);
            color: var(--bg);
            text-decoration: none;
            border-radius: 4px;
            font-weight: 600;
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        a:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

        a:focus-visible {
            outline: 2px solid var(--text);
            outline-offset: 4px;
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>404</h1>
        <p>Page not found. The page you're looking for doesn't exist or has been moved.</p>
        <a href="/">Go home</a>
    </div>
</body>
</html>
