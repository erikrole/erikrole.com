---
import '@/styles/globals.css';

const pageTitle = "404 — Erik Role";
const pageDescription = "Page not found";
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f5efe2" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#221f1c" media="(prefers-color-scheme: dark)">
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription}>
    <meta name="robots" content="noindex">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/favicon.svg">

    <script is:inline>
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('theme'); } catch (e) {}
            var darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
            var dark = stored ? stored === 'dark' : darkQuery.matches;
            if (dark) {
                document.documentElement.classList.add('dark');
                document.documentElement.setAttribute('data-theme', 'dark');
            }
            darkQuery.addEventListener('change', function (e) {
                var saved = null;
                try { saved = localStorage.getItem('theme'); } catch (err) {}
                if (saved) return;
                document.documentElement.classList.toggle('dark', e.matches);
                document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
            });
        })();
    </script>

    <style>
        .nf {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            text-align: center;
            animation: fade 480ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
        }
        .nf-inner { max-width: 460px; }
        .nf-code {
            font-family: var(--font-display);
            font-size: clamp(72px, 14vw, 112px);
            font-weight: 400;
            line-height: 1;
            margin: 0 0 16px;
            letter-spacing: -0.02em;
            color: var(--ink);
        }
        .nf-msg {
            font-family: var(--font-sans);
            font-size: 16px;
            color: var(--ink-3);
            margin: 0 0 32px;
            line-height: 1.55;
        }
        .nf-btn {
            display: inline-block;
            padding: 12px 22px;
            background: var(--ink);
            color: var(--bg);
            border-radius: 8px;
            font-family: var(--font-sans);
            font-weight: 600;
            font-size: 14px;
            transition: transform 200ms cubic-bezier(0.2, 0.7, 0.2, 1), background 200ms ease;
        }
        .nf-btn:hover { transform: translateY(-1px); background: var(--ink-2); }
        @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
    </style>
</head>
<body>
    <main class="nf">
        <div class="nf-inner">
            <h1 class="nf-code">404</h1>
            <p class="nf-msg">Page not found. The link may be broken, or the page has moved.</p>
            <a href="/" class="nf-btn">Go home</a>
        </div>
    </main>
</body>
</html>
