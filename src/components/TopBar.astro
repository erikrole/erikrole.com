---
import Icon from '@/components/Icon.astro';
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="topbar" id="topbar">
    <div class="topbar-inner">
        <a href="#top" class="mark" aria-label="Erik Role — back to top">
            <span class="mark-dot" aria-hidden="true"></span>
            <span class="mark-text">Erik Role</span>
        </a>
        <nav class="topnav" aria-label="Sections">
            <a href="#work">Work</a>
            <a href="#about" class="topnav-about">About</a>
            <a href="#experience">Experience</a>
            <a href="#contact">Contact</a>
        </nav>
        <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Dark theme" aria-pressed="false">
            <span class="theme-toggle-sun"><Icon name="sun" size={15} /></span>
            <span class="theme-toggle-moon"><Icon name="moon" size={15} /></span>
        </button>
    </div>
</header>
